# Copie este arquivo para .env e preencha com os valores reais.
# O .env nunca é commitado (veja .gitignore); só o .env.example fica versionado.
#
# Os scripts de scripts/ leem estas variáveis do ambiente:
#   set -a; source .env; set +a
#
# Login e senha do administrador do Azure SQL (criados por 02-criar-banco.sh).
# Login: não pode ser admin, sa, root ou administrator.
# Senha: maiúscula, minúscula, número e símbolo, sem ; ' " ou $.
DB_USER=
DB_PASSWORD=

# URL JDBC impressa no fim de 02-criar-banco.sh (não é segredo, mas fica junto).
DB_URL=

# Segredo de assinatura dos tokens JWT, com pelo menos 32 caracteres.
# Gere um valor aleatório, por exemplo: openssl rand -base64 48
JWT_SECRET=
