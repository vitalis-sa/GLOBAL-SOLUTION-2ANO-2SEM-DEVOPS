# Copie este arquivo para .env e preencha com os valores reais.
# O .env nunca é commitado (veja .gitignore); só o .env.example fica versionado.
# Use finais de linha LF: um "\r" no fim da linha entra no valor da variável.
#
# Os scripts de scripts/ leem estas variáveis do ambiente. No Git Bash:
#   while IFS='=' read -r k v; do v="${v%$'\r'}"; [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] && export "$k=$v"; done < .env
#
# ---------- Oracle no Azure Container Instances (scripts 03 e 05) ----------
# Usuário (schema) da aplicação, compartilhado pelas APIs Java e .NET.
DB_USER=REMEMBERED
# Senha do usuário da aplicação. Só letras e números, começando por letra.
DB_PASSWORD=
# Senha do SYS e do SYSTEM. Fica só com quem opera a infraestrutura.
ORACLE_PASSWORD=
# URL JDBC impressa no fim de 03-criar-banco.sh (não é segredo, mas fica junto).
DB_URL=jdbc:oracle:thin:@//rm566234-gs-oracle.eastus.azurecontainer.io:1521/FREEPDB1

# ---------- Aplicação (valores que a Release grava no Web App) ----------
# Segredo de assinatura dos tokens JWT (>= 32 caracteres), IGUAL ao da API .NET.
JWT_SECRET=
# AMQP URL da instância do CloudAMQP (amqps://usuario:senha@host/vhost).
CLOUDAMQP_URL=
# Chave do Groq (console.groq.com/keys). Sem ela, o relatório de adesão sai só com os números.
GROQ_API_KEY=

# ---------- Só para rodar a API na sua máquina (run.ps1) ----------
# O banco da Azure é o mesmo da produção: deixe os jobs e os consumidores desligados.
JOBS_HABILITADOS=false
RABBIT_CONSUMIDORES=false
